{
  "expo": {
    "name": "ReadSession",
    "slug": "readsession",
    "version": "0.2.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.readsession.app",
      "versionCode": 2,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a cover for your book",
          "cameraPermission": "Take a cover photo for your book",
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      "./plugins/withReleaseSigning",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan book ISBN barcodes",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "platforms": [
      "android"
    ]
  }
}
